function SlmProgAttrSlot(const AAttrName: String): Integer; inline;
begin
  if (AAttrName = 'position') then
    Exit(0);
  if (AAttrName = 'normal') then
    Exit(1);
  if (AAttrName = 'jindices') then
    Exit(2);
  if (AAttrName = 'jweights') then
    Exit(3);
  Result := -1;
end;

function SlmProgTextureSlot(const ATexName: String): Integer; inline;
begin
  if (ATexName = 'joint_tex') then
    Exit(0);
  Result := -1;
end;

function SlmProgSamplerSlot(const ASmpName: String): Integer; inline;
begin
  if (ASmpName = 'smp') then
    Exit(0);
  Result := -1;
end;

function SlmProgUniformBlockSlot(const AUBName: String): Integer; inline;
begin
  if (AUBName = 'vs_params') then
    Exit(0);
  if (AUBName = 'phong_params') then
    Exit(1);
  Result := -1;
end;

function SlmProgUniformBlockSize(const AUBName: String): NativeInt; inline;
begin
  if (AUBName = 'vs_params') then
    Exit(SizeOf(TSlmVSParams));
  if (AUBName = 'phong_params') then
    Exit(SizeOf(TSlmPhongParams));
  Result := 0;
end;

function SlmProgUniformOffset(const AUBName, AUName: String): Integer; inline;
begin
  if (AUBName = 'vs_params') then
  begin
    if (AUName = 'mvp') then
      Exit(0);
    if (AUName = 'model') then
      Exit(64);
    if (AUName = 'joint_uv') then
      Exit(128);
    if (AUName = 'joint_pixel_width') then
      Exit(136);
  end;
  if (AUBName = 'phong_params') then
  begin
    if (AUName = 'light_dir') then
      Exit(0);
    if (AUName = 'eye_pos') then
      Exit(16);
    if (AUName = 'light_color') then
      Exit(32);
    if (AUName = 'mat_diffuse') then
      Exit(48);
    if (AUName = 'mat_specular') then
      Exit(64);
    if (AUName = 'mat_spec_power') then
      Exit(76);
  end;
  Result := -1;
end;

function SlmProgUniformDesc(const AUBName, AUName: String): TGlslShaderUniform; inline;
begin
  Result := Default(TGlslShaderUniform);
  if (AUBName = 'vs_params') then
  begin
    if (AUName = 'mvp') then
    begin
      Result.UniformType := TUniformType.Mat4;
      Result.ArrayCount := 0;
      Result.GlslName := 'mvp';
      Exit;
    end;
    if (AUName = 'model') then
    begin
      Result.UniformType := TUniformType.Mat4;
      Result.ArrayCount := 0;
      Result.GlslName := 'model';
      Exit;
    end;
    if (AUName = 'joint_uv') then
    begin
      Result.UniformType := TUniformType.Float2;
      Result.ArrayCount := 0;
      Result.GlslName := 'joint_uv';
      Exit;
    end;
    if (AUName = 'joint_pixel_width') then
    begin
      Result.UniformType := TUniformType.Float;
      Result.ArrayCount := 0;
      Result.GlslName := 'joint_pixel_width';
      Exit;
    end;
  end;
  if (AUBName = 'phong_params') then
  begin
    if (AUName = 'light_dir') then
    begin
      Result.UniformType := TUniformType.Float3;
      Result.ArrayCount := 0;
      Result.GlslName := 'light_dir';
      Exit;
    end;
    if (AUName = 'eye_pos') then
    begin
      Result.UniformType := TUniformType.Float3;
      Result.ArrayCount := 0;
      Result.GlslName := 'eye_pos';
      Exit;
    end;
    if (AUName = 'light_color') then
    begin
      Result.UniformType := TUniformType.Float3;
      Result.ArrayCount := 0;
      Result.GlslName := 'light_color';
      Exit;
    end;
    if (AUName = 'mat_diffuse') then
    begin
      Result.UniformType := TUniformType.Float3;
      Result.ArrayCount := 0;
      Result.GlslName := 'mat_diffuse';
      Exit;
    end;
    if (AUName = 'mat_specular') then
    begin
      Result.UniformType := TUniformType.Float3;
      Result.ArrayCount := 0;
      Result.GlslName := 'mat_specular';
      Exit;
    end;
    if (AUName = 'mat_spec_power') then
    begin
      Result.UniformType := TUniformType.Float;
      Result.ArrayCount := 0;
      Result.GlslName := 'mat_spec_power';
      Exit;
    end;
  end;
end;

