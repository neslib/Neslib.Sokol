end;

function LProgUniformDesc(const AUBName, AUName: String): TGlslShaderUniform; inline;
begin
  Result := Default(TGlslShaderUniform);
  if (AUBName = 'vs_params') then
  begin
    if (AUName = 'mvp') then
    begin
      Result.UniformType := TUniformType.Mat4;
      Result.ArrayCount := 0;
      Result.GlslName := 'mvp';
      Exit;
    end;
    if (AUName = 'model') then
    begin
      Result.UniformType := TUniformType.Mat4;
      Result.ArrayCount := 0;
      Result.GlslName := 'model';
      Exit;
    end;
  end;
  if (AUBName = 'phong_params') then
  begin
    if (AUName = 'light_dir') then
    begin
      Result.UniformType := TUniformType.Float3;
      Result.ArrayCount := 0;
      Result.GlslName := 'light_dir';
      Exit;
    end;
    if (AUName = 'eye_pos') then
    begin
      Result.UniformType := TUniformType.Float3;
      Result.ArrayCount := 0;
      Result.GlslName := 'eye_pos';
      Exit;
    end;
    if (AUName = 'light_color') then
    begin
      Result.UniformType := TUniformType.Float3;
      Result.ArrayCount := 0;
      Result.GlslName := 'light_color';
      Exit;
    end;
  end;
end;

